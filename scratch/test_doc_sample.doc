<style>
@page Section1 {
  size: 8.27in 11.69in; /* A4 */
  margin: 0.8in 0.8in 0.8in 0.8in;
  mso-header-margin: 0.5in;
  mso-footer-margin: 0.5in;
  mso-paper-source: 0;
}
div.Section1 {
  page: Section1;
}
body {
  font-family: 'Calibri', 'Segoe UI', Arial, sans-serif;
  color: #1e293b;
  line-height: 1.35;
  font-size: 11pt;
}
.header-container {
  text-align: center;
  margin-bottom: 8px;
}
.univ-title {
  color: #1e3a8a;
  font-size: 13.5pt;
  font-weight: bold;
  letter-spacing: 0.3px;
  margin: 0;
  text-transform: uppercase;
}
.univ-subtitle {
  color: #334155;
  font-size: 9.5pt;
  margin: 2px 0;
}
.header-divider {
  border: none;
  border-top: 1.5px solid #1e3a8a;
  margin: 8px 0 12px 0;
}
.doc-title {
  color: #1e3a8a;
  font-size: 12.5pt;
  font-weight: bold;
  text-decoration: underline;
  text-align: center;
  margin: 10px 0 14px 0;
  text-transform: uppercase;
}
.section-banner {
  background-color: #f1f5f9;
  border-left: 5px solid #1d4ed8;
  padding: 6px 10px;
  font-weight: bold;
  font-size: 10.5pt;
  color: #1e3a8a;
  margin-top: 12px;
  margin-bottom: 0px;
}
table.form-table {
  width: 100%;
  border-collapse: collapse;
  margin-bottom: 6px;
  border: 1px solid #cbd5e1;
}
table.form-table td {
  padding: 6px 10px;
  font-size: 10pt;
  vertical-align: middle;
  border: 1px solid #cbd5e1;
}
table.form-table td.label-cell {
  width: 34%;
  font-weight: bold;
  color: #1e293b;
  background-color: #ffffff;
}
table.form-table td.value-cell {
  width: 66%;
  color: #0f172a;
  background-color: #ffffff;
}
</style>
</head>
<body>
